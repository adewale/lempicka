# Copy this file to .env for local prompt-tuning scripts:
#   cp .env.example .env
#
# Direct Node scripts can load it with:
#   node --env-file=.env test/test-replicate-direct.js
#
# Wrangler local development uses .dev.vars. You can also copy this file to
# .dev.vars or set the secret with Wrangler for deployment:
#   wrangler secret put REPLICATE_API_TOKEN

REPLICATE_API_TOKEN=your_replicate_api_token_here
