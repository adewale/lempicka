{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "lempicka",
  "main": "src/index.js",
  "compatibility_date": "2024-12-01",

  // Import HTML as text module
  "rules": [
    { "type": "Text", "globs": ["**/*.html"] }
  ],

  // KV namespace for storing recent transformations
  "kv_namespaces": [
    { "binding": "GALLERY", "id": "8e12048e2aba46649ee4fdb2603b5262" }
  ]

  // Replicate API key - set via `wrangler secret put REPLICATE_API_TOKEN`
  // Do not commit secrets to version control
}
